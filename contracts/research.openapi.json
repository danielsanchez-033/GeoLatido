  "components": {
    "schemas": {
      "AreaIn": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "description": "Id de un lugar del nomenclátor (GET /places)."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox",
            "description": "[oeste, sur, este, norte] en WGS84."
          }
        },
        "type": "object",
        "title": "AreaIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PeriodIn": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "PeriodIn"
      },
      "ResearchIn": {
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "areas": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AreaIn"
                },
                "type": "array",
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Areas"
          },
          "period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PeriodIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "phenomena": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [

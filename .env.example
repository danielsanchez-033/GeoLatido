# Token de NASA Earthdata para leer gránulos reales. Copiar a .env y nunca subirlo.
EARTHDATA_TOKEN=

# Cuentas de prueba del servicio auth (T-ANT-15): python -m auth seed-accounts. Mínimo 12 caracteres.
# Sin contraseña no se crea esa cuenta. Los correos son opcionales.
AUTH_TEST_STUDENT_PASSWORD=
AUTH_TEST_STUDENT_EMAIL=
AUTH_TEST_RESEARCHER_PASSWORD=
AUTH_TEST_RESEARCHER_EMAIL=

# Motor de investigación (services/research), opcionales. Sin ellas, esas dos fuentes salen como needs_credentials.
# ReliefWeb (OCHA): nombre de aplicación aprobado; se pide en https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# NASA FIRMS (fuego activo): MAP_KEY gratuita en https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
